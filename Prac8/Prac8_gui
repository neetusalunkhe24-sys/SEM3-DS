)

title.pack(fill="x")

frame = tk.Frame(window, bg="#E8F8F5")
frame.pack(pady=20)

tk.Label(frame,
         text="AVL Values (comma separated)",
         bg="#E8F8F5",
         font=("Arial", 11, "bold")).grid(row=0, column=0)

avl_entry = tk.Entry(frame, width=40)
avl_entry.grid(row=1, column=0, padx=10, pady=5)
