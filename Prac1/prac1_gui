import tkinter as tk
from tkinter import messagebox

class Stack:
    def __init__(self):
        self.items = []

    def push(self, item):
        self.items.append(item)

    def pop(self):
        if self.items:
            return self.items.pop()
        return None

    def peek(self):
        return self.items[-1] if self.items else "Empty"

    def size(self):
        return len(self.items)

    def empty(self):
        return len(self.items) == 0

stack = Stack()


def update_stack():
    if stack.items:
        stack_box.config(
            text="\n".join(reversed(stack.items))
        )
    else:
        stack_box.config(text="STACK EMPTY")


def push_item():
    value = entry.get()

    if value:
        stack.push(value)
        info.config(text=f"Added → {value}")
        entry.delete(0, tk.END)
        update_stack()

    else:
        messagebox.showwarning(
            "Input",
            "Enter value"
        )


def pop_item():
    value = stack.pop()

    if value:
        info.config(text=f"Removed → {value}")
    else:
        info.config(text="Nothing to remove")

    update_stack()


def peek_item():
    info.config(
        text=f"Top → {stack.peek()}"
    )


def size_item():
    info.config(
        text=f"Size → {stack.size()}"
    )


def empty_item():
    text = "YES" if stack.empty() else "NO"

    info.config(
        text=f"Empty → {text}"
    )


root = tk.Tk()
root.title("Stack Operations")
root.geometry("820x550")
root.configure(bg="#111827")

# Title
title = tk.Label(
    root,
    text="STACK OPERATIONS",
    bg="#111827",
    fg="#00D1FF",
    font=("Bahnschrift", 24, "bold")
)

title.pack(pady=20)

# Input
entry = tk.Entry(
    root,
    font=("Segoe UI", 14),
    width=28,
    bg="#1F2937",
    fg="white",
    insertbackground="white"
)

entry.pack(pady=10)

# Buttons
btn_frame = tk.Frame(
    root,
    bg="#111827"
)

btn_frame.pack(pady=20)

style = {
    "font": ("Segoe UI", 11, "bold"),
    "width": 10,
    "height": 2,
    "bd": 0
}

tk.Button(
    btn_frame,
    text="Push",
    bg="#2563EB",
    fg="white",
    command=push_item,
    **style
).grid(row=0, column=0, padx=8)

tk.Button(
    btn_frame,
    text="Pop",
    bg="#DC2626",
    fg="white",
    command=pop_item,
    **style
).grid(row=0, column=1, padx=8)

tk.Button(
    btn_frame,
    text="Peek",
    bg="#059669",
    fg="white",
    command=peek_item,
    **style
).grid(row=0, column=2, padx=8)

tk.Button(
    btn_frame,
    text="Empty",
    bg="#D97706",
    fg="white",
    command=empty_item,
    **style
).grid(row=0, column=3, padx=8)

tk.Button(
    btn_frame,
    text="Size",
    bg="#7C3AED",
    fg="white",
    command=size_item,
    **style
).grid(row=0, column=4, padx=8)


# Stack Box
stack_box = tk.Label(
    root,
    text="STACK EMPTY",
    width=28,
    height=8,
    bg="#1F2937",
    fg="#00D1FF",
    relief="solid",
    font=("Consolas", 14)
)

stack_box.pack(pady=25)

# Description
tk.Label(
    root,
    text="DESCRIPTION",
    bg="#111827",
    fg="#9CA3AF",
    font=("Bahnschrift", 16, "bold")
).pack()

info = tk.Label(
    root,
    text="Perform stack operations",
    bg="#1F2937",
    fg="white",
    width=55,
    height=4,
    font=("Segoe UI", 12)
)

info.pack(pady=15)

root.mainloop()

